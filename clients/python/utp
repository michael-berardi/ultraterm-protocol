#!/usr/bin/env python3
# canonical home; UltraTerm vendors this
"""utp — UltraTerm Protocol CLI.

Control socket for UltraTerm terminals and UltraTerm Profiles (harness-scoped launch choices; legacy OMP adapter for mutations).
Speaks JSON Lines to ~/.ultraterm/utp.sock.

Usage:
  utp list                              # read-only attached-terminal inventory
  utp inspect --slot 2 [--lines 80] [--raw] [--no-uc]
                                        # read-only PTY history; model-readable UC (c=j/r)
  utp send --slot 2 "ls -la"            # target PTY input + Enter
  utp message --from 1 --to 2 "tests are green"
                                        # native durable inbox; unsupported hosts fail, no PTY input
  utp open --harness HARNESS --profile NAME [--title s] [--confirm]
                                        # lowest free slot; dry-run by default
  utp close --slot N [--expected-id ID] [--confirm]
                                        # target slot only; dry-run binds ID
  utp switch-profile PROFILE [--harness omp] [--slot N] [--expected-id ID] [--confirm]
                                        # target replacement; dry-run binds ID
  utp handoff [--harness HARNESS] --profile NAME (--slot N | --new-slot) --packet /tmp/PACKET --manager-slot M
                                        # dry-run; confirmation requires user permission
  utp report --route ROUTE --project NAME [--new ITEM] [--changed ITEM] [--fixed ITEM]
                                        # structured text update; repeat flags for list items
  utp report --route ROUTE --project NAME --kind file --file /path/to.zip [--summary CAPTION]
                                        # file-only document delivery
  utp report --route ROUTE --project NAME --kind image --file /path/to.png [--summary CAPTION]
                                        # image delivery
  utp redact --route ROUTE --project NAME --message-id N [--message-id N ...] --reason TEXT
                                        # delete the bot's own prior messages; explicit IDs only
  utp register-manager --from N --from-id ID --slot N --expected-id ID
  utp task-done --from-id ID --summary TEXT [--from N] [--to N --expected-id ID]
  utp profiles list
  utp profiles create --adapter omp NAME MODEL THINKING [--title-model MODEL] [--routing UPSTREAM[,UPSTREAM...]]
  utp profiles remove --adapter omp NAME
"""

from __future__ import annotations
import argparse
import json
import os
import re
import socket
import stat
import subprocess
import sys
import time

SOCKET_PATH = os.path.expanduser("~/.ultraterm/utp.sock")
REPORT_HOOK_PATH = os.path.expanduser(
    os.environ.get("UTP_REPORT_HOOK", "~/.ultraterm/report-hook")
)
ROUTE_RE = re.compile(r"^[a-z0-9][a-z0-9._:-]{0,127}$")
PROJECT_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
TECHNICAL_REPORT_NOISE_RE = re.compile(
    r"(?i)\b(?:verified|verification|rollback|commit|sha|origin/main|"
    r"deploy(?:ed|ment)?|tests?\s+passed|test suite|testing\s+(?:passed|completed)|pytest|vitest|eslint|typescript|"
    r"cloudflare worker|(?:internal|build) workflow|version id)\b"
)
# Abbreviated or full commit hashes: 7-40 hex characters mixing digits and letters.
COMMIT_ID_RE = re.compile(r"(?i)\b(?=[0-9a-f]*[a-f])(?=[0-9a-f]*[0-9])[0-9a-f]{7,40}\b")
# Well-known credential shapes and explicit secret assignments.
PROTECTED_VALUE_RE = re.compile(
    r"\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_\w{20,}|sk-[A-Za-z0-9_-]{20,}|xox[abeprs]-[A-Za-z0-9-]{10,}"
    r"|AKIA[0-9A-Z]{16}|\d{6,}:[A-Za-z0-9_-]{30,}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.)"
    r"|-----BEGIN [A-Z ]*PRIVATE KEY-----"
    r"|(?i:\b(?:password|passwd|secret|token|api[_-]?key)\s*=\s*\S)"
)
MAX_REPORT_ITEMS = 24
MAX_SECTION_ITEMS = 12
MAX_REPORT_ITEM_CHARS = 240


def normalize_report_items(values: list[str], name: str) -> list[str]:
    items = []
    seen = set()
    for raw in values:
        text = raw.strip()
        if len(text.splitlines()) > 1:
            raise SystemExit(f"utp report: --{name} items must stay on a single line")
        text = re.sub(r"^(?:[-*•]\s*)", "", text).strip()
        if not text or len(text) > MAX_REPORT_ITEM_CHARS:
            raise SystemExit(
                f"utp report: --{name} items must contain 1-{MAX_REPORT_ITEM_CHARS} characters"
            )
        if TECHNICAL_REPORT_NOISE_RE.search(text) or COMMIT_ID_RE.search(text):
            raise SystemExit(f"utp report: --{name} contains technical workflow noise")
        if PROTECTED_VALUE_RE.search(text):
            raise SystemExit(f"utp report: --{name} contains a protected value")
        key = text.casefold()
        if key not in seen:
            seen.add(key)
            items.append(text)
    if len(items) > MAX_SECTION_ITEMS:
        raise SystemExit(f"utp report: --{name} accepts at most {MAX_SECTION_ITEMS} items")
    return items




MAX_REPLY_BYTES = 1024 * 1024
TRANSPORT_TIMEOUT = 10
READ_ONLY_COMMANDS = {"list", "inspect", "diagnose", "profiles.list", "profiles.catalog", "message.receipt"}


def call(request: dict) -> dict:
    sent = False
    readonly = request.get("cmd") in READ_ONLY_COMMANDS or (
        request.get("cmd") in {"open", "close", "profile.switch"} and not request.get("confirm")
    )

    def fail(reason: str) -> None:
        outcome = ("; mutation outcome unknown; do not retry automatically; reconcile with read-only queries"
                   if sent and not readonly else
                   "; no request sent" if not sent else "; read-only request failed")
        raise SystemExit("utp: " + reason + outcome)

    payload = json.dumps(request).encode() + b"\n"
    if len(payload) > 65536:
        fail("request exceeds 65536-byte limit")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            deadline = time.monotonic() + TRANSPORT_TIMEOUT
            sock.settimeout(TRANSPORT_TIMEOUT)
            sock.connect(SOCKET_PATH)
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                fail("transport timeout")
            sock.settimeout(remaining)
            # sendall may partially write before failing; never replay the request.
            sent = True
            sock.sendall(payload)
            data = bytearray()
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    fail("transport timeout")
                sock.settimeout(remaining)
                chunk = sock.recv(min(65536, MAX_REPLY_BYTES + 1 - len(data)))
                if not chunk:
                    fail("truncated reply" if data else "disconnected before reply")
                data.extend(chunk)
                newline = data.find(b"\n")
                if newline >= 0:
                    if newline > MAX_REPLY_BYTES:
                        fail("oversized reply")
                    line = bytes(data[:newline])
                    break
                if len(data) > MAX_REPLY_BYTES:
                    fail("oversized reply")
    except socket.timeout:
        fail("transport timeout")
    except FileNotFoundError:
        fail("control socket not found (is UltraTerm running?)")
    except ConnectionRefusedError:
        fail("control socket connection refused")
    except OSError:
        fail("control socket disconnected or unavailable")
    try:
        response = json.loads(line)
    except (ValueError, UnicodeError, RecursionError):
        fail("malformed JSON reply")
    if not isinstance(response, dict) or type(response.get("ok")) is not bool:
        fail("malformed reply: expected object with boolean ok")
    if response["ok"] and request.get("cmd") == "inspect" and not isinstance(response.get("text"), str):
        fail("malformed inspect reply: expected text string")
    return response


def run_uc(command: list[str], **kwargs) -> subprocess.CompletedProcess:
    try:
        return subprocess.run(command, **kwargs)
    except (OSError, subprocess.SubprocessError):
        raise SystemExit("utp: optional UC codec unavailable or timed out; for plain inspection use --no-uc") from None


def profile_create_request(args: argparse.Namespace) -> dict:
    name = args.name or args.name_option
    model = args.model or args.model_option
    thinking = args.thinking or args.thinking_option
    missing = [label for label, value in (("name", name), ("model", model), ("thinking", thinking)) if not value]
    if missing:
        raise SystemExit(f"utp profiles create: missing {', '.join(missing)}")
    request = {
        "cmd": "profiles.create",
        "name": name,
        "model": model,
        "thinkingLevel": thinking,
    }
    title_model = args.title_model or args.title_model_option
    if title_model:
        request["titleModel"] = title_model
    routing = getattr(args, "routing", None)
    if routing:
        request["routing"] = routing.strip()
    return request


def add_profile_commands(sub: argparse._SubParsersAction) -> None:
    profiles = sub.add_parser("profiles", help="UltraTerm Profiles: catalog and legacy OMP adapter")
    profile_sub = profiles.add_subparsers(dest="profiles_cmd", required=True)
    listing = profile_sub.add_parser("list", help="list UltraTerm Profiles by harness")
    listing.add_argument("--adapter", choices=["omp"], help="list legacy OMP adapter profiles instead")

    create = profile_sub.add_parser("create", help="create a profile through the legacy OMP adapter only")
    create.add_argument("--adapter", choices=["omp"], required=True)
    create.add_argument("name", nargs="?")
    create.add_argument("model", nargs="?")
    create.add_argument("thinking", nargs="?")
    create.add_argument("--name", dest="name_option")
    create.add_argument("--model", dest="model_option")
    create.add_argument("--thinking", dest="thinking_option")
    create.add_argument("--title-model")
    create.add_argument("--routing", help="comma-separated upstream model ids")
    create.add_argument("--titleModel", dest="title_model_option")

    remove = profile_sub.add_parser("remove", help="remove an inactive legacy OMP adapter profile")
    remove.add_argument("--adapter", choices=["omp"], required=True)
    remove.add_argument("name")


def new_receipt_id() -> str:
    import uuid  # deferred: only receipt-bearing messages need it

    return str(uuid.uuid4())


def print_error(response: dict) -> None:
    if not response.get("ok"):
        message = f"utp: {response.get('error', 'request failed')}"
        if response.get("committed") is True:
            # Spec 3.6: the mutation committed although a later cleanup step failed.
            message += "; the change was committed, so do not retry it; reconcile with 'utp list'"
        sys.exit(message)


def dynamic_tmux_slot() -> int | None:
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        return None
    try:
        result = subprocess.run(
            ["tmux", "display-message", "-p", "-t", pane, "#{session_name}"],
            check=False,
            capture_output=True,
            text=True,
            timeout=1,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    match = re.fullmatch(r"ultraterm-matrix-([1-8])", result.stdout.strip())
    return int(match.group(1)) if result.returncode == 0 and match else None


def caller_slot(explicit, command: str) -> int:
    if explicit is not None:
        return explicit
    slot = dynamic_tmux_slot()
    if slot is None:
        if os.environ.get("TMUX_PANE"):
            raise SystemExit(f"utp {command}: cannot resolve current tmux slot; pass --from explicitly")
        value = os.environ.get("ULTRATERM_SLOT")
        try:
            slot = int(value or "")
        except ValueError:
            slot = 0
    if slot <= 0:
        raise SystemExit(
            f"utp {command}: run inside an UltraTerm session or pass --from"
        )
    return slot


def optional_caller_slot() -> int | None:
    slot = dynamic_tmux_slot()
    if slot is not None:
        return slot
    value = os.environ.get("ULTRATERM_SLOT")
    try:
        slot = int(value or "")
    except ValueError:
        return None
    return slot if slot > 0 else None

def handoff_packet_path(value: str) -> str:
    path = os.path.abspath(value)
    # /tmp and the platform temp dir (macOS TMPDIR lives under /var/folders,
    # a symlink family away from /tmp) are both acceptable staging areas.
    roots = [os.path.realpath("/tmp")]
    import tempfile  # deferred: only handoff needs it, and it slows every call

    platform_temp = os.path.realpath(tempfile.gettempdir())
    if platform_temp not in roots:
        roots.append(platform_temp)
    resolved = os.path.realpath(path)
    inside = False
    for root in roots:
        try:
            if os.path.commonpath((resolved, root)) == root:
                inside = True
                break
        except ValueError:
            continue
    if not inside:
        raise SystemExit("utp handoff: packet must resolve to a file under /tmp")
    # The resolved path is typed into the worker PTY: a CR/LF would submit a
    # truncated, unvalidated path and escape sequences would reach the TUI.
    if re.search(r"[\x00-\x1f\x7f-\x9f]", resolved):
        raise SystemExit("utp handoff: packet path must not contain control characters")
    try:
        details = os.lstat(path)
    except FileNotFoundError:
        raise SystemExit(f"utp handoff: packet not found at {path}") from None
    if not stat.S_ISREG(details.st_mode) or stat.S_ISLNK(details.st_mode):
        raise SystemExit("utp handoff: packet must be a regular file, not a symlink")
    if details.st_uid != os.getuid():
        raise SystemExit("utp handoff: packet must be owned by the current user")
    if details.st_mode & (stat.S_IRWXG | stat.S_IRWXO):
        raise SystemExit("utp handoff: packet must be private (chmod 600)")
    if details.st_size <= 0 or details.st_size > 16 * 1024:
        raise SystemExit("utp handoff: packet must contain 1-16384 bytes")
    return resolved


def wait_for_terminal_ready(slot: int) -> None:
    output_seen = False
    for _ in range(60):
        response = call({"cmd": "inspect", "slot": slot, "lines": 30, "raw": False})
        if response.get("ok") and response.get("text", "").strip():
            if output_seen:
                time.sleep(0.75)
                return
            output_seen = True
        time.sleep(0.5)
    raise SystemExit(
        f"utp handoff: Terminal {slot} did not produce stable output within 30 seconds; "
        "packet was not submitted"
    )


def submit_handoff(session: dict, packet: str) -> None:
    prompt = (
        f"Read the authoritative handoff packet at {packet}. Continue every remaining "
        "todo without repeating completed work. Reuse its resources and artifacts, "
        "preserve its constraints and decisions, and verify before reporting."
    )
    # Pin delivery to the session ID captured at open/switch time: the server
    # refuses the send when that slot now holds a different session.
    response = call({
        "cmd": "send",
        "slot": session["slot"],
        "expectedId": session["id"],
        "text": prompt,
        "enter": True,
    })
    print_error(response)


def cleanup_opened_handoff(session: dict) -> None:
    """Close the pane this handoff opened, bound to the ID it was opened with."""
    try:
        response = call({
            "cmd": "close",
            "slot": session["slot"],
            "expectedId": session["id"],
            "confirm": True,
        })
    except SystemExit as error:
        # Never mask the handoff error that triggered cleanup; the close outcome
        # is unknown and stays the operator's decision to reconcile.
        print(
            f"utp handoff: cleanup for slot {session['slot']} ({session['id']}) "
            f"did not confirm: {error}",
            file=sys.stderr,
        )
        return
    if not response.get("ok") and response.get("committed") is True:
        print(
            f"utp handoff: cleanup closed slot {session['slot']} ({session['id']}) but "
            f"reported: {response.get('error', 'request failed')}",
            file=sys.stderr,
        )
    elif not response.get("ok"):
        print(
            f"utp handoff: cleanup failed for slot {session['slot']} ({session['id']}): "
            f"{response.get('error', 'request failed')}",
            file=sys.stderr,
        )


def report_uncertain_submission(session: dict) -> None:
    """An attempted packet may already be delivering, so its pane is never closed."""
    print(
        f"utp handoff: submission to slot {session['slot']} ({session['id']}) did not "
        "confirm; the packet may already be delivering, so that session was left "
        f"untouched — verify with 'utp inspect --slot {session['slot']}', adopt it, or "
        f"close it explicitly with --expected-id {session['id']}",
        file=sys.stderr,
    )


def run_hook(command: str, payload: dict) -> None:
    hook = os.path.realpath(REPORT_HOOK_PATH)
    try:
        details = os.stat(hook)
    except FileNotFoundError:
        raise SystemExit(
            f"utp {command}: hook not found at {REPORT_HOOK_PATH}; install a user-owned executable hook"
        ) from None
    parent = os.stat(os.path.dirname(hook))
    if parent.st_uid != os.getuid() or parent.st_mode & (stat.S_IWGRP | stat.S_IWOTH):
        raise SystemExit(f"utp {command}: hook directory must be current-user-owned and private")
    if not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid():
        raise SystemExit(f"utp {command}: hook must be a regular file owned by the current user")
    if details.st_mode & (stat.S_IWGRP | stat.S_IWOTH) or not os.access(hook, os.X_OK):
        raise SystemExit(f"utp {command}: hook must be executable and not group/world writable")

    result = subprocess.run([hook], input=json.dumps(payload), text=True, check=False)
    if result.returncode != 0:
        raise SystemExit(result.returncode)


def validate_route_project(command: str, args: argparse.Namespace) -> None:
    if not args.user_authorized:
        raise SystemExit(
            f"utp {command}: --user-authorized is required after explicit user permission"
        )
    if not ROUTE_RE.fullmatch(args.route):
        raise SystemExit(
            f"utp {command}: route must use lowercase letters, numbers, dots, colons, underscores, or hyphens"
        )
    if not PROJECT_RE.fullmatch(args.project):
        raise SystemExit(f"utp {command}: project must use lowercase letters, numbers, and hyphens")


def run_redact_hook(args: argparse.Namespace) -> None:
    validate_route_project("redact", args)
    ids = sorted(set(args.message_id))
    if not ids or len(ids) > 20:
        raise SystemExit("utp redact: provide 1-20 --message-id values")
    if any(i <= 0 for i in ids):
        raise SystemExit("utp redact: message IDs must be positive integers")
    reason = (args.reason or "").strip()
    if not reason or len(reason) > 300:
        raise SystemExit("utp redact: --reason must contain 1-300 characters")
    payload = {
        "op": "redact",
        "project": args.project,
        "route": args.route,
        "message_ids": ids,
        "reason": reason,
    }
    run_hook("redact", payload)


def run_report_hook(args: argparse.Namespace) -> None:
    validate_route_project("report", args)
    payload = {
        "project": args.project,
        "kind": args.kind,
        "route": args.route,
    }
    if args.kind == "report":
        if args.file:
            raise SystemExit("utp report: --file only applies to --kind file|image")
        if args.summary:
            raise SystemExit("utp report: --summary only applies to --kind file|image")
        new = normalize_report_items(args.new_items, "new")
        changed = normalize_report_items(args.changed_items, "changed")
        fixed = normalize_report_items(args.fixed_items, "fixed")
        if not any((new, changed, fixed)):
            raise SystemExit("utp report: provide at least one --new, --changed, or --fixed item")
        if len(new) + len(changed) + len(fixed) > MAX_REPORT_ITEMS:
            raise SystemExit(f"utp report: structured updates accept at most {MAX_REPORT_ITEMS} items")
        payload.update({"new": new, "changed": changed, "fixed": fixed})
    else:
        if any((args.new_items, args.changed_items, args.fixed_items)):
            raise SystemExit("utp report: --new/--changed/--fixed only apply to text reports")
        if not args.file:
            raise SystemExit(f"utp report: --kind {args.kind} requires --file PATH")
        caption = (args.summary or "").strip()
        if len(caption) > 1024:
            raise SystemExit("utp report: caption (--summary) must contain at most 1024 characters")
        path = os.path.realpath(os.path.expanduser(args.file))
        try:
            info = os.stat(path)
        except FileNotFoundError:
            raise SystemExit(f"utp report: file not found: {args.file}") from None
        if not stat.S_ISREG(info.st_mode):
            raise SystemExit("utp report: --file must be a regular file")
        if info.st_size == 0:
            raise SystemExit("utp report: --file must not be empty")
        if info.st_size > 45 * 1024 * 1024:
            raise SystemExit("utp report: --file exceeds the 45 MiB delivery limit")
        payload.update({"summary": caption, "file": path})

    run_hook("report", payload)


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="utp",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("--version", action="version", version="2.2.0")
    sub = parser.add_subparsers(dest="cmd", required=True)
    sub.add_parser("diagnose", help="read-only aggregate control socket health (JSON)")
    sub.add_parser("list", help="list attached terminals")

    inspect = sub.add_parser("inspect", help="show recent output of a terminal")
    inspect.add_argument("--slot", type=int)
    inspect.add_argument("--id")
    inspect.add_argument("--lines", type=int, default=80)
    inspect.add_argument("--raw", action="store_true")

    savings = sub.add_parser(
        "savings", help="tokens saved by UltraTerm (day / 7d / 30d / all-time)"
    )
    savings.add_argument("--rate", type=float,
                         help="optional dollars per 1M tokens for the estimate")
    inspect.add_argument("--no-uc", action="store_true",
                         help="emit plain terminal text instead of an UltraCompact packet")

    send = sub.add_parser("send", help="send input to a terminal's PTY")
    send.add_argument("--slot", type=int)
    send.add_argument("--id")
    send.add_argument("--expected-id", help="reject a replaced or renumbered target")
    send.add_argument("text")
    send.add_argument("--no-enter", action="store_true")

    open = sub.add_parser("open", help="start a new UltraTerm session")
    open.add_argument("--harness", default="steak-pi", help="UltraTerm harness id (default: steak-pi; omp selects legacy adapter)")
    open.add_argument("--profile", required=True, help="UltraTerm Profile id within the selected harness")
    open.add_argument("--title", help="display title for the new terminal")
    open.add_argument("--confirm", action="store_true",
                      help="actually create the session (default: dry run)")

    switch_profile = sub.add_parser(
        "switch-profile",
        help="replace an OMP terminal profile in place (backend limitation)",
    )
    switch_profile.add_argument("profile", help="legacy OMP adapter profile to launch")
    switch_profile.add_argument("--harness", choices=["omp"], default="omp", help="in-place backend currently supports omp only")
    switch_profile.add_argument("--slot", type=int, help="terminal slot; defaults to ULTRATERM_SLOT")
    switch_profile.add_argument("--confirm", action="store_true",
                                help="actually switch the profile (default: dry run)")
    switch_profile.add_argument("--expected-id",
                                help="session id printed by the matching dry run")

    handoff = sub.add_parser(
        "handoff",
        help="transfer a compact context packet to a replacement or new worker",
    )
    handoff.add_argument("--profile", required=True, help="UltraTerm Profile id for the receiving worker")
    handoff.add_argument("--harness", help="new slot: defaults to steak-pi; in-place: omp only (default)")
    target = handoff.add_mutually_exclusive_group(required=True)
    target.add_argument("--slot", type=int, help="replace the worker in this slot")
    target.add_argument("--new-slot", action="store_true", help="open the lowest free worker slot")
    handoff.add_argument("--packet", required=True, help="private handoff Markdown under /tmp")
    handoff.add_argument("--title", help="title for a new worker slot")
    handoff.add_argument("--manager-slot", type=int, required=True, help="manager to register for the receiving worker")
    handoff.add_argument("--expected-id", help="session id printed by an in-place dry run")
    handoff.add_argument("--confirm", action="store_true", help="perform the handoff")
    handoff.add_argument(
        "--user-authorized",
        action="store_true",
        help="assert that the user explicitly authorized terminal orchestration",
    )

    close = sub.add_parser("close", help="gracefully close a terminal session")
    close.add_argument("--slot", type=int, required=True)
    close.add_argument("--confirm", action="store_true",
                       help="actually close the session (default: dry run)")
    close.add_argument("--expected-id",
                       help="session id printed by the matching dry run")
    message = sub.add_parser("message", help="durably queue a peer message; not proof of host delivery")
    message.add_argument("--from", dest="from_slot", type=int, help="sender slot; defaults to ULTRATERM_SLOT")
    message.add_argument("--to", type=int, required=True)
    message.add_argument("text")
    message.add_argument("--notice-only", action="store_true", help="ephemeral workspace banner only")
    message.add_argument("--receipt-id", help="stable UUID for receipt lookup and server-supported deduplication; generated before transmission if absent")
    receipt = sub.add_parser("receipt", help="read durable message receipt (never model-read proof)")
    receipt.add_argument("receipt_id")
    message.add_argument("--expected-id", help="target session ID from list")

    register_manager = sub.add_parser(
        "register-manager",
        help="register this worker terminal's manager",
    )
    register_manager.add_argument("--from-id", required=True, help="stable worker session ID from list; never infer from a slot")
    register_manager.add_argument("--expected-id", required=True, help="stable manager session ID from list")
    register_manager.add_argument("--slot", type=int, required=True, help="manager terminal slot")
    register_manager.add_argument("--from", dest="from_slot", type=int, help="worker terminal slot")

    task_done = sub.add_parser("task-done", help="report completion to the previously registered native conversations (also required for --to)")
    task_done.add_argument("--from-id", required=True, help="worker session ID captured at task assignment")
    task_done.add_argument("--summary", required=True)
    task_done.add_argument("--receipt-id", help="stable UUID for receipt lookup and server-supported deduplication")
    task_done.add_argument("--expected-id", help="manager session ID from list")
    task_done.add_argument("--from", dest="from_slot", type=int, help="worker terminal slot")
    task_done.add_argument("--to", type=int, help="manager terminal slot override")

    report = sub.add_parser("report", help="send a structured project update through a local user hook")
    report.add_argument("--project", required=True)
    report.add_argument(
        "--kind",
        choices=("report", "file", "image"),
        default="report",
        help="delivery kind: structured text update (default), file-only document, or image",
    )
    report.add_argument("--file", help="file to deliver for --kind file|image")
    report.add_argument("--new", dest="new_items", action="append", default=[], help="new user-facing addition; repeat for list items")
    report.add_argument("--changed", dest="changed_items", action="append", default=[], help="user-facing change; repeat for list items")
    report.add_argument("--fixed", dest="fixed_items", action="append", default=[], help="user-facing fix; repeat for list items")
    report.add_argument("--summary", help="optional caption for file/image deliveries")
    report.add_argument("--route", required=True, help="user-owned local route alias")
    report.add_argument(
        "--user-authorized",
        action="store_true",
        help="assert that the user explicitly authorized external delivery",
    )

    redact = sub.add_parser("redact", help="delete the bot's own prior messages by explicit ID")
    redact.add_argument("--project", required=True)
    redact.add_argument("--route", required=True, help="user-owned local route alias")
    redact.add_argument(
        "--message-id",
        type=int,
        action="append",
        required=True,
        help="message ID to delete; repeat for multiple (max 20)",
    )
    redact.add_argument("--reason", required=True, help="why deletion is prudent (audit logged)")
    redact.add_argument(
        "--user-authorized",
        action="store_true",
        help="assert that the user explicitly authorized deletion",
    )
    add_profile_commands(sub)

    args = parser.parse_args()

    if args.cmd == "diagnose":
        response = call({"cmd": "diagnose"})
        print_error(response)
        print(json.dumps(response))
        return

    if args.cmd == "report":
        run_report_hook(args)
        return

    if args.cmd == "redact":
        run_redact_hook(args)
        return

    if args.cmd == "list":
        response = call({"cmd": "list"})
        print_error(response)
        for session in sorted(response["sessions"], key=lambda s: s["slot"]):
            harness = session.get("harnessId") or "shell"
            profile = session.get("launchProfile") or "-"
            print(f"{session['slot']}\t{session['title']}\t{harness}\t{profile}\t{session['id']}")
        return

    if args.cmd == "profiles":
        if args.profiles_cmd == "list":
            response = call({"cmd": "profiles.list" if args.adapter == "omp" else "profiles.catalog"})
            print_error(response)
            for harness in response.get("harnesses", []):
                for profile in harness.get("profiles", []):
                    print(f"{harness['id']}\t{profile['id']}\t{profile['name']}")
            for profile in response.get("profiles", []):
                state = "active" if profile.get("active") else "inactive"
                print(f"{profile['name']}\t{state}")
            return
        if args.profiles_cmd == "create":
            response = call(profile_create_request(args))
            print_error(response)
            if response.get("profile"):
                print(response["profile"]["name"])
            return
        response = call({"cmd": "profiles.remove", "name": args.name})
        print_error(response)
        return

    if args.cmd == "savings":
        uc_bin = os.environ.get("UC_BIN") or os.path.expanduser(
            "~/.ultraterm/bin/uc"
        )
        command = [uc_bin, "telemetry"]
        if args.rate is not None:
            command.extend(["--rate", str(args.rate)])
        proc = run_uc(
            command, capture_output=True, text=True, timeout=30,
        )
        if proc.returncode != 0:
            sys.exit(f"utp: UC telemetry failed: {proc.stderr.strip()}")
        sys.stdout.write(proc.stdout)
        return

    if args.cmd == "inspect":
        request = {"cmd": "inspect", "lines": args.lines, "raw": args.raw}
        # The id is the identity and takes precedence over the slot (spec 3.2).
        if args.id:
            request["id"] = args.id
        elif args.slot is not None:
            request["slot"] = args.slot
        else:
            sys.exit("utp inspect: --slot or --id required")
        response = call(request)
        print_error(response)
        if not getattr(args, "no_uc", False):
            uc_bin = os.environ.get("UC_BIN") or os.path.expanduser(
                "~/.ultraterm/bin/uc"
            )
            payload = json.dumps(
                {"slot": response.get("slot"), "text": response["text"]},
                separators=(",", ":"),
            )
            uc_env = {**os.environ, "UC_TELEMETRY_SOURCE": "utp"}
            if "UC_TELEMETRY" not in uc_env and "UC_TELEMETRY_PATH" not in uc_env:
                default_sink = os.path.expanduser(
                    "~/.local/state/ultracompact/telemetry.jsonl"
                )
                if os.path.isfile(default_sink):
                    uc_env["UC_TELEMETRY_PATH"] = default_sink
            proc = run_uc([uc_bin, "encode", "--readable", "--stats"], input=payload,
                                  capture_output=True, text=True, timeout=30,
                                  env=uc_env)
            if proc.returncode != 0:
                sys.exit(f"utp: UC encoding failed: {proc.stderr.strip()}")
            if proc.stderr.strip():
                print(proc.stderr.strip(), file=sys.stderr)
            print(proc.stdout, end="")
            return
        print(response["text"])
        return

    if args.cmd == "send":
        request = {"cmd": "send", "text": args.text, "enter": not args.no_enter}
        # Never drop an explicit id: it takes precedence over the slot.
        if args.id:
            request["id"] = args.id
        elif args.slot is not None:
            request["slot"] = args.slot
        else:
            sys.exit("utp send: --slot or --id required")
        if args.expected_id:
            request["expectedId"] = args.expected_id
        response = call(request)
        print_error(response)
        print("PTY input queued; write and agent acknowledgment unconfirmed")
        return

    if args.cmd == "handoff":
        harness = args.harness or ("steak-pi" if args.new_slot else "omp")
        if not args.new_slot and harness != "omp":
            sys.exit("utp handoff: in-place backend supports omp only; use --new-slot for other harnesses")
        packet = handoff_packet_path(args.packet)
        if args.confirm and not args.user_authorized:
            sys.exit(
                "utp handoff: --confirm requires --user-authorized after explicit user permission"
            )
        caller = optional_caller_slot()
        if not args.new_slot and args.manager_slot == args.slot:
            sys.exit("utp handoff: a worker cannot be its own manager")
        if args.confirm and not args.new_slot and caller == args.slot:
            sys.exit(
                "utp handoff: in-place handoff must run from its manager or an external shell "
                "so the sender survives the replacement"
            )
        if args.confirm and caller is not None and caller != args.manager_slot:
            sys.exit("utp handoff: the calling terminal must match --manager-slot")
        inventory = call({"cmd": "list"})
        print_error(inventory)
        sessions_by_slot = {
            session["slot"]: session for session in inventory.get("sessions", [])
        }
        if args.manager_slot not in sessions_by_slot:
            sys.exit(f"utp handoff: no live manager on slot {args.manager_slot}")

        if args.new_slot:
            request = {"cmd": "open", "harnessId": harness, "profile": args.profile, "confirm": args.confirm}
            if args.title:
                request["title"] = args.title
            response = call(request)
            print_error(response)
            if not args.confirm:
                would = response.get("would", {})
                print(
                    f"utp handoff: would open worker slot {would.get('slot')} with "
                    f"UltraTerm Profile '{args.profile}' (harness {harness}) managed by slot {args.manager_slot}"
                )
                print(
                    "Dry run only — re-run with --confirm --user-authorized "
                    "after explicit user permission."
                )
                return
            session = response["session"]
            try:
                wait_for_terminal_ready(session["slot"])
                registration = call({
                    "cmd": "register.manager",
                    "from": session["slot"],
                    "fromId": session["id"],
                    "to": args.manager_slot,
                    "expectedId": sessions_by_slot[args.manager_slot]["id"],
                })
                print_error(registration)
            except BaseException:
                # Nothing was submitted: no packet can be in flight, so the pane
                # this handoff opened is ours to close (identity-bound). This also
                # covers print_error/SystemExit, readiness timeout and Ctrl-C.
                cleanup_opened_handoff(session)
                raise
            try:
                submit_handoff(session, packet)
            except BaseException:
                # The send may have reached the PTY before the failure: keep the
                # worker and let the operator reconcile instead of discarding work.
                report_uncertain_submission(session)
                raise
            target_slot = session["slot"]
        else:
            if args.confirm and not args.expected_id:
                sys.exit(
                    "utp handoff: in-place --confirm requires --expected-id from a fresh dry run"
                )
            if args.confirm:
                current = sessions_by_slot.get(args.slot)
                if current is None or current.get("id") != args.expected_id:
                    found = current.get("id") if current else "no session"
                    sys.exit(
                        f"utp handoff: worker target changed before confirmation; "
                        f"expected {args.expected_id}, found {found}; nothing was changed"
                    )
            request = {
                "cmd": "profile.switch",
                "harnessId": harness,
                "slot": args.slot,
                "profile": args.profile,
                "confirm": args.confirm,
            }
            if args.expected_id:
                request["expectedId"] = args.expected_id
            response = call(request)
            print_error(response)
            if not args.confirm:
                would = response.get("would", {})
                expected_id = would.get("id")
                if not expected_id:
                    sys.exit(
                        "utp handoff: running UltraTerm predates identity-bound "
                        "confirmation; restart or update the app, then dry-run again"
                    )
                print(
                    f"utp handoff: would replace worker slot {args.slot} ({expected_id}) "
                    f"with UltraTerm Profile '{args.profile}' managed by slot {args.manager_slot}"
                )
                print(
                    f"Dry run only — re-run with --confirm --user-authorized "
                    f"--expected-id {expected_id} after explicit user permission."
                )
                return
            session = response["session"]
            target_slot = session["slot"]
            wait_for_terminal_ready(target_slot)
            registration = call({
                "cmd": "register.manager", "from": target_slot, "fromId": session["id"],
                "to": args.manager_slot, "expectedId": sessions_by_slot[args.manager_slot]["id"],
            })
            print_error(registration)
            try:
                submit_handoff(session, packet)
            except BaseException:
                # Never close an in-place replacement whose packet may be in flight.
                report_uncertain_submission(session)
                raise

        print(f"handoff submitted to worker slot {target_slot}\t{packet}")
        return

    if args.cmd == "open":
        request = {"cmd": "open", "harnessId": args.harness, "profile": args.profile, "confirm": args.confirm}
        if args.title:
            request["title"] = args.title
        response = call(request)
        print_error(response)
        if not args.confirm:
            would = response.get("would", {})
            line = f"utp open: would start terminal slot {would.get('slot')} with UltraTerm Profile '{args.profile}'"
            if would.get("title"):
                line += f" titled '{would['title']}'"
            print(line)
            print("Dry run only — re-run with --confirm to create the session.")
            return
        session = response["session"]
        print(f"opened slot {session['slot']}\t{session['id']}")
        return

    if args.cmd == "switch-profile":
        slot = caller_slot(args.slot, args.cmd)
        if args.confirm and not args.expected_id:
            sys.exit("utp switch-profile: --confirm requires --expected-id from a fresh dry run")
        request = {
            "cmd": "profile.switch",
            "harnessId": args.harness,
            "slot": slot,
            "profile": args.profile,
            "confirm": args.confirm,
        }
        if args.expected_id:
            request["expectedId"] = args.expected_id
        response = call(request)
        print_error(response)
        if not args.confirm:
            would = response.get("would", {})
            expected_id = would.get("id")
            if not expected_id:
                sys.exit(
                    "utp switch-profile: running UltraTerm predates identity-bound "
                    "confirmation; restart or update the app, then dry-run again"
                )
            print(f"utp switch-profile: would replace slot {slot} ({expected_id}) with UltraTerm Profile '{args.profile}'")
            print(
                f"Dry run only — re-run with --confirm --expected-id {expected_id} "
                "to switch that exact session."
            )
            return
        session = response["session"]
        print(f"switched slot {session['slot']} to {args.profile}\t{session['id']}")
        return

    if args.cmd == "close":
        if args.confirm and not args.expected_id:
            sys.exit("utp close: --confirm requires --expected-id from a fresh dry run")
        request = {"cmd": "close", "slot": args.slot, "confirm": args.confirm}
        if args.expected_id:
            request["expectedId"] = args.expected_id
        response = call(request)
        print_error(response)
        if not args.confirm:
            would = response.get("would", {})
            expected_id = would.get("id")
            print(
                f"utp close: would gracefully close slot {would.get('slot')} "
                f"({expected_id})"
            )
            print(
                f"Dry run only — re-run with --confirm --expected-id {expected_id} "
                "to close that exact session."
            )
            return
        closed = response["closed"]
        print(f"closed slot {closed['slot']}\t{closed['id']}")
        return

    if args.cmd == "register-manager":
        response = call({
            "cmd": "register.manager",
            "from": caller_slot(args.from_slot, args.cmd),
            "fromId": args.from_id,
            "expectedId": args.expected_id,
            "to": args.slot,
        })
        print_error(response)
        print(f"manager slot {response['managerSlot']} registered for worker slot {response['from']}")
        return

    if args.cmd == "receipt":
        response = call({"cmd": "message.receipt", "receiptId": args.receipt_id})
        print_error(response)
        print(json.dumps(response))
        return

    if args.cmd == "task-done":
        if args.to is not None and not args.expected_id:
            sys.exit("utp task-done: --to requires --expected-id; never guess a replacement manager")
        request = {
            "cmd": "task.done",
            "fromId": args.from_id,
            "text": args.summary,
        }
        if args.from_slot is not None:
            request["from"] = args.from_slot
        if args.to is not None:
            request["to"] = args.to
        if args.expected_id:
            request["expectedId"] = args.expected_id
        request["receiptId"] = args.receipt_id or new_receipt_id()
        print(f"receiptId={request['receiptId']} (query receipt before considering retry)", file=sys.stderr, flush=True)
        response = call(request)
        print_error(response)
        print(json.dumps(response))
        return

    request = {"cmd": "message", "from": caller_slot(args.from_slot, args.cmd), "to": args.to, "text": args.text}
    if args.expected_id:
        request["expectedId"] = args.expected_id
    request["noticeOnly"] = args.notice_only
    if not args.notice_only:
        request["receiptId"] = args.receipt_id or new_receipt_id()
        print(f"receiptId={request['receiptId']} (query receipt before considering retry)", file=sys.stderr, flush=True)
    response = call(request)
    print_error(response)
    if args.notice_only:
        print("Workspace notice accepted only; not delivered to agent (no acknowledgment)")
    else:
        print(json.dumps(response))


if __name__ == "__main__":
    main()
