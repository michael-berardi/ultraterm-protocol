#!/usr/bin/env python3
# canonical home; UltraTerm vendors this
"""utp — UltraTerm Protocol CLI.

Control socket for UltraTerm terminals and UltraTerm Profiles (harness-scoped launch choices; legacy OMP adapter for mutations).
Speaks JSON Lines to ~/.ultraterm/utp.sock.

Usage:
  utp list                              # read-only attached-terminal inventory
  utp inspect --slot 2 [--lines 80] [--raw] [--no-uc]
                                        # read-only PTY history; --no-uc is a deprecated no-op
  utp send --slot 2 "ls -la"            # target PTY input + Enter
  utp refit [--slot N]                  # refit and redraw one terminal, or all; output only
  utp message --from 1 --to 2 "tests are green"
                                        # native durable inbox; unsupported hosts fail, no PTY input
  utp open --harness HARNESS --profile NAME [--title s] [--confirm]
                                        # lowest free slot; dry-run by default
  utp close --slot N [--expected-id ID] [--confirm]
                                        # target slot only; dry-run binds ID
  utp switch-profile PROFILE [--harness omp] [--slot N] [--expected-id ID] [--confirm]
                                        # target replacement; dry-run binds ID
  utp handoff [--harness HARNESS] --profile NAME (--slot N | --new-slot) --packet /tmp/PACKET --manager-slot M
                                        # dry-run; confirmation requires user permission
  utp report --route ROUTE --project NAME [--new ITEM] [--changed ITEM] [--fixed ITEM]
                                        # structured text update; repeat flags for list items
  utp report --route ROUTE --project NAME --kind file --file /path/to.zip [--summary CAPTION]
                                        # file-only document delivery
  utp report --route ROUTE --project NAME --kind image --file /path/to.png [--summary CAPTION]
                                        # image delivery
  utp redact --route ROUTE --project NAME --message-id N [--message-id N ...] --reason TEXT
                                        # delete the bot's own prior messages; explicit IDs only
  utp register-manager --from N --from-id ID --slot N --expected-id ID
  utp task-done --from-id ID --summary TEXT [--from N] [--to N --expected-id ID]
  utp profiles list
  utp profiles create --adapter omp NAME MODEL THINKING [--title-model MODEL] [--routing UPSTREAM[,UPSTREAM...]]
  utp profiles remove --adapter omp NAME
  utp profiles hidden                   # read-only: HARNESS/PROFILE of every hidden profile
  utp profiles hide|show HARNESS/PROFILE [--confirm]
                                        # hide or show one profile in every picker; dry run by default
  utp dials list                        # read-only: id, enabled, kind, order and name of every usage dial
  utp dials enable|disable ID [--confirm]
                                        # dry run by default
  utp update [--check|--skip|--auto on|off|status|--checks on|off|status|--rollback]
                                        # local client update; never sent to the socket
"""

from __future__ import annotations
import argparse
import errno
import json
import os
import re
import socket
import stat
import subprocess
import sys
import time

SOCKET_PATH = os.path.expanduser("~/.ultraterm/utp.sock")
REPORT_HOOK_PATH = os.path.expanduser(
    os.environ.get("UTP_REPORT_HOOK", "~/.ultraterm/report-hook")
)
ROUTE_RE = re.compile(r"^[a-z0-9][a-z0-9._:-]{0,127}$")
PROJECT_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,63}$")
TECHNICAL_REPORT_NOISE_RE = re.compile(
    r"(?i)\b(?:verified|verification|rollback|commit|sha|origin/main|"
    r"deploy(?:ed|ment)?|tests?\s+passed|test suite|testing\s+(?:passed|completed)|pytest|vitest|eslint|typescript|"
    r"cloudflare worker|(?:internal|build) workflow|version id)\b"
)
# Abbreviated or full commit hashes: 7-40 hex characters mixing digits and letters.
COMMIT_ID_RE = re.compile(r"(?i)\b(?=[0-9a-f]*[a-f])(?=[0-9a-f]*[0-9])[0-9a-f]{7,40}\b")
# Well-known credential shapes and explicit secret assignments.
PROTECTED_VALUE_RE = re.compile(
    r"\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_\w{20,}|sk-[A-Za-z0-9_-]{20,}|xox[abeprs]-[A-Za-z0-9-]{10,}"
    r"|AKIA[0-9A-Z]{16}|\d{6,}:[A-Za-z0-9_-]{30,}|eyJ[A-Za-z0-9_-]{10,}\.[A-Za-z0-9_-]{10,}\.)"
    r"|-----BEGIN [A-Z ]*PRIVATE KEY-----"
    r"|(?i:\b(?:password|passwd|secret|token|api[_-]?key)\s*=\s*\S)"
)
MAX_REPORT_ITEMS = 24
MAX_SECTION_ITEMS = 12
MAX_REPORT_ITEM_CHARS = 240

# Client updates: one anonymous release lookup and local file operations. They never use
# the control socket and do not change the wire protocol. See docs/updates.md.
CLIENT_VERSION = "2.9.0"
UPDATE_REPO_URL = "https://github.com/michael-berardi/ultraterm-protocol"
UPDATE_USER_AGENT = "utp-update-check"
UPDATE_INTERVAL = 24 * 60 * 60
UPDATE_TIMEOUT = 4.0
UPDATE_DOWNLOAD_TIMEOUT = 30.0
UPDATE_MAX_BYTES = 2 * 1024 * 1024
UPDATE_LOG_LIMIT = 256 * 1024
ROLLBACK_MAX_AGE = 7 * 24 * 60 * 60
PROCESS_STARTED = time.time()
STABLE_VERSION_RE = re.compile(r"v?(\d+)\.(\d+)\.(\d+)")
CLIENT_VERSION_LINE_RE = re.compile(rb'^CLIENT_VERSION = "([^"]*)"$', re.MULTILINE)
CONTROL_CHARS_RE = re.compile(r"[\x00-\x1f\x7f-\x9f]")
UPDATE_DEFAULTS = {
    "checkedAt": 0, "latest": None, "error": None, "skip": None,
    "auto": False, "checks": True, "autoAsked": False,
    "notifiedVersion": None, "notifiedAt": 0,
    "installFailed": None, "installError": None,
}


class UpdateError(Exception):
    """A refused or failed update; the installed client is unchanged."""


def parse_version(value):
    """A stable x.y.z (optionally v-prefixed) as a tuple; anything else is None."""
    match = STABLE_VERSION_RE.fullmatch(value.strip()) if isinstance(value, str) else None
    return tuple(int(part) for part in match.groups()) if match else None


def is_newer(candidate, current=CLIENT_VERSION):
    new, old = parse_version(candidate), parse_version(current)
    return bool(new and old and new > old)


def describe_error(exc):
    text = CONTROL_CHARS_RE.sub(" ", str(exc)).strip()
    return f"{type(exc).__name__}: {text}"[:240] if text else type(exc).__name__


def update_dir():
    if sys.platform == "darwin":
        base = os.path.expanduser("~/Library/Caches")
    else:
        base = os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache")
    return os.path.join(base, "utp")


def update_state_path():
    return os.path.join(update_dir(), "update.json")


def update_log_path():
    return os.path.join(update_dir(), "update.log")


def write_private(path, data):
    """Atomically replace path with data, mode 0600, in a 0700 directory."""
    import tempfile
    os.makedirs(os.path.dirname(path), mode=0o700, exist_ok=True)
    descriptor, temporary = tempfile.mkstemp(prefix=".utp-", dir=os.path.dirname(path))
    try:
        with os.fdopen(descriptor, "wb") as handle:
            handle.write(data)
        os.replace(temporary, path)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)


def load_update_state():
    state = dict(UPDATE_DEFAULTS)
    try:
        with open(update_state_path(), encoding="utf-8") as handle:
            stored = json.loads(handle.read(16384))
    except (OSError, ValueError, RecursionError):
        return state
    if isinstance(stored, dict):
        for key, default in UPDATE_DEFAULTS.items():
            value = stored.get(key, default)
            if (value is None and default is None) or isinstance(
                    value, str if default is None else type(default)):
                state[key] = value
    return state


def save_update_state(state):
    write_private(update_state_path(), json.dumps(state, sort_keys=True).encode())


def log_update(message):
    """Append one line to the automatic-install log, keeping it under UPDATE_LOG_LIMIT."""
    path = update_log_path()
    stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    line = f"{stamp} {CONTROL_CHARS_RE.sub(' ', message)[:1000]}\n".encode()
    try:
        with open(path, "rb") as handle:
            old = handle.read()
    except OSError:
        old = b""
    write_private(path, (old + line)[-UPDATE_LOG_LIMIT:])


def fetch_latest_release():
    """One anonymous GET of the public latest-release record: (stable version or None, notes)."""
    from urllib.request import Request, urlopen
    repo = UPDATE_REPO_URL.split("github.com/", 1)[1]
    url = os.environ.get("UTP_UPDATE_API") or f"https://api.github.com/repos/{repo}/releases/latest"
    request = Request(url, headers={
        "User-Agent": UPDATE_USER_AGENT, "Accept": "application/vnd.github+json",
    })
    with urlopen(request, timeout=UPDATE_TIMEOUT) as response:
        release = json.loads(response.read(UPDATE_MAX_BYTES))
    if not isinstance(release, dict):
        raise UpdateError("the release record is not a JSON object")
    version = parse_version(release.get("tag_name"))
    if version is None or release.get("draft") or release.get("prerelease"):
        return None, ""
    notes = release.get("body")
    return ".".join(map(str, version)), notes if isinstance(notes, str) else ""


def refresh_update_state(state):
    """Check now, record the latest stable version or the failure cause; return the notes."""
    notes = ""
    state["checkedAt"] = int(time.time())
    try:
        state["latest"], notes = fetch_latest_release()
        state["error"] = None
    except Exception as exc:
        state["error"] = describe_error(exc)
    save_update_state(state)
    return notes


def update_checks_silenced():
    """Automatic checks stay off when opted out, in CI, under an agent and off a terminal."""
    for name in ("UTP_NO_UPDATE_CHECK", "CI", "CLAUDECODE"):
        if os.environ.get(name, "").strip().lower() not in ("", "0", "false"):
            return True
    return not all(stream is not None and stream.isatty() for stream in (sys.stdout, sys.stderr))


def current_client():
    return os.path.realpath(__file__)


def client_manager(path):
    """Who updates this copy: None for a standalone file, else (owner, command or None)."""
    managed_root = os.path.realpath(os.path.expanduser("~/.ultraterm")) + os.sep
    if path.startswith(managed_root) or ".app/Contents/" in path:
        return ("UltraTerm", None)
    root = os.path.dirname(os.path.dirname(os.path.dirname(path)))
    if (path.endswith(os.sep + os.path.join("clients", "python", "utp"))
            and os.path.exists(os.path.join(root, ".git"))):
        return ("git", ["git", "-C", root, "pull", "--ff-only"])
    return None


def update_notice(latest, manager):
    import shlex
    command = shlex.join(manager[1]) if manager else "utp update"
    automatic = "" if manager else "turn on automatic updates: utp update --auto on · "
    return (f"utp {latest} available (you have {CLIENT_VERSION}) · run: {command}",
            f"{automatic}skip: utp update --skip")


def start_update_check():
    """Start the daily check beside the user's command; None when checks are off here."""
    if update_checks_silenced():
        return None
    manager = client_manager(current_client())
    if manager and manager[1] is None:
        return None  # UltraTerm's own copy updates with UltraTerm
    import threading
    result = {}

    def check():
        try:
            state = load_update_state()
            if state["checks"]:
                if not 0 <= time.time() - state["checkedAt"] < UPDATE_INTERVAL:
                    refresh_update_state(state)
                result["state"] = state
        except Exception:
            pass  # a failed check must never add noise to the user's command

    thread = threading.Thread(target=check, daemon=True)
    try:
        thread.start()
    except RuntimeError:
        return None
    return thread, result


def finish_update_check(pending):
    """After a successful command: print the notice, or start an opted-in install."""
    thread, result = pending
    thread.join(UPDATE_TIMEOUT)
    state = result.get("state")
    try:
        latest = state and state["latest"]
        if not is_newer(latest) or state["skip"] == latest or (
                state["notifiedVersion"] == latest
                and 0 <= time.time() - state["notifiedAt"] < UPDATE_INTERVAL):
            return
        state["notifiedVersion"], state["notifiedAt"] = latest, int(time.time())
        save_update_state(state)  # before the installer starts, so it can record a failure
        manager = client_manager(current_client())
        if state["auto"] and manager is None and state["installFailed"] != latest:
            start_auto_install()
            return
        first, second = update_notice(latest, manager)
        plain = os.environ.get("NO_COLOR") or os.environ.get("TERM", "dumb") == "dumb"
        print(first, file=sys.stderr)
        print(second if plain else f"\033[2m{second}\033[0m", file=sys.stderr)
    except Exception:
        pass


def start_auto_install():
    """A detached, low-priority installer; it logs to the bounded update log."""
    subprocess.Popen(
        [sys.executable, current_client(), "update", "--auto-install"],
        stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        start_new_session=True,
    )


def download_release_file(version, name):
    from urllib.request import Request, urlopen
    repo = UPDATE_REPO_URL.split("github.com/", 1)[1]
    base = os.environ.get("UTP_UPDATE_DOWNLOAD") or f"https://raw.githubusercontent.com/{repo}"
    url = f"{base}/v{version}/clients/python/{name}"
    request = Request(url, headers={"User-Agent": UPDATE_USER_AGENT})
    with urlopen(request, timeout=UPDATE_DOWNLOAD_TIMEOUT) as response:
        data = response.read(UPDATE_MAX_BYTES + 1)
    if len(data) > UPDATE_MAX_BYTES:
        raise UpdateError(f"{name} is larger than {UPDATE_MAX_BYTES} bytes")
    return data


def verified_client(version):
    """Download release `version` and verify it against its SHA256SUMS before any swap."""
    import hashlib
    client = download_release_file(version, "utp")
    sums = download_release_file(version, "SHA256SUMS").decode("utf-8", "replace")
    expected = None
    for line in sums.splitlines():
        fields = line.split()
        if len(fields) == 2 and fields[1].lstrip("*") in ("utp", "clients/python/utp"):
            expected = fields[0].lower()
    if expected is None:
        raise UpdateError("SHA256SUMS has no entry for utp")
    if hashlib.sha256(client).hexdigest() != expected:
        raise UpdateError("checksum mismatch")
    found = CLIENT_VERSION_LINE_RE.search(client)
    if found is None or found.group(1).decode("utf-8", "replace") != version:
        raise UpdateError(f"the downloaded client is not version {version}")
    return client


def install_client(version, target):
    """Verify, then swap atomically, keeping exactly one rollback at <client>.previous."""
    import shutil
    import tempfile
    client = verified_client(version)
    mode = stat.S_IMODE(os.stat(target).st_mode)
    with tempfile.TemporaryDirectory(prefix="utp-update-", dir=os.path.dirname(target)) as work:
        staged, backup = os.path.join(work, "utp"), os.path.join(work, "previous")
        with open(staged, "wb") as handle:
            handle.write(client)
        shutil.copyfile(target, backup)
        for path in (staged, backup):
            os.chmod(path, mode)
        os.replace(backup, target + ".previous")
        os.replace(staged, target)
    return target + ".previous"


def remove_rollback(after_success):
    """Drop <client>.previous once the installed client ran successfully, or after 7 days."""
    previous = current_client() + ".previous"
    try:
        made = os.path.getmtime(previous)
        if (after_success and made < PROCESS_STARTED) or time.time() - made > ROLLBACK_MAX_AGE:
            os.unlink(previous)
    except OSError:
        pass


def ask(question, default):
    try:
        answer = input(question).strip().lower()
    except (EOFError, KeyboardInterrupt):
        print(file=sys.stderr)
        return False
    return answer in ("y", "yes") or (default and answer == "")


def run_auto_install():
    try:
        os.nice(10)
    except (AttributeError, OSError):
        pass
    state = load_update_state()
    latest = state["latest"]
    if not is_newer(latest) or client_manager(current_client()):
        return 0
    try:
        install_client(latest, current_client())
    except Exception as exc:
        cause = describe_error(exc)
        state.update(installFailed=latest, installError=cause, notifiedVersion=None)
        save_update_state(state)
        log_update(f"automatic install of utp {latest} failed: {cause}")
        return 1
    state.update(installFailed=None, installError=None)
    save_update_state(state)
    log_update(f"installed utp {latest}; it applies on the next run")
    return 0


def run_update(args) -> int:
    target = current_client()
    manager = client_manager(target)
    state = load_update_state()
    if args.auto_install:
        return run_auto_install()
    if args.rollback:
        if not os.path.isfile(target + ".previous"):
            print("utp update: no previous client to restore", file=sys.stderr)
            return 1
        os.replace(target + ".previous", target)
        state["skip"] = CLIENT_VERSION  # the version just removed is not offered again
        save_update_state(state)
        print(f"restored the previous client; utp {CLIENT_VERSION} is skipped")
        return 0
    if args.auto == "status":
        print("automatic updates: " + ("on" if state["auto"] else "off"))
        if state["installFailed"]:
            print(f"last automatic install failed: {state['installError']}")
        return 0
    if args.auto == "on":
        state.update(auto=True, autoAsked=True, installFailed=None, installError=None)
        save_update_state(state)
        print("automatic updates: on")
        return 0
    if args.auto == "off":
        for path in (update_state_path(), update_log_path()):
            if os.path.exists(path):
                os.unlink(path)
        if not state["checks"]:
            save_update_state({**UPDATE_DEFAULTS, "checks": False, "autoAsked": True})
        else:
            try:
                os.rmdir(update_dir())
            except OSError:
                pass
        print("automatic updates: off; update state removed")
        return 0
    if args.checks:
        if args.checks != "status":
            state["checks"] = args.checks == "on"
            save_update_state(state)
        print("update checks: " + ("on" if state["checks"] else "off"))
        return 0
    if args.skip and is_newer(state["latest"]) and not state["error"]:
        notes = ""  # skip what the notice showed, without another request
    else:
        notes = refresh_update_state(state)
    if state["error"]:
        print(f"utp update: check failed: {state['error']}", file=sys.stderr)
        return 1
    latest = state["latest"]
    if not is_newer(latest):
        print(f"utp {CLIENT_VERSION} is current")
        return 0
    if args.skip:
        state["skip"] = latest
        save_update_state(state)
        print(f"utp {latest} skipped; a newer release will notify again")
        return 0
    print(f"utp {CLIENT_VERSION} → {latest}")
    lines = [CONTROL_CHARS_RE.sub("", line).strip()[:160] for line in notes.splitlines()]
    for line in [line for line in lines if line][:6]:
        print("  " + line)
    if args.check:
        return 10
    if manager and manager[1] is None:
        print(f"utp update: this client is managed by {manager[0]}; update {manager[0]} instead",
              file=sys.stderr)
        return 1
    interactive = sys.stdin.isatty() and sys.stdout.isatty()
    if interactive and not ask(f"Install {latest} now? [Y/n] ", default=True):
        return 0
    if manager:
        return subprocess.call(manager[1])
    try:
        install_client(latest, target)
    except Exception as exc:
        print(f"utp update: {describe_error(exc)}; the installed client is unchanged",
              file=sys.stderr)
        return 1
    print(f"installed utp {latest}; undo with: utp update --rollback")
    if interactive and not state["auto"] and not state["autoAsked"]:
        state.update(auto=ask("Install future updates automatically? [y/N] ", default=False),
                     autoAsked=True)
        save_update_state(state)
    return 0


def normalize_report_items(values: list[str], name: str) -> list[str]:
    items = []
    seen = set()
    for raw in values:
        text = raw.strip()
        if len(text.splitlines()) > 1:
            raise SystemExit(f"utp report: --{name} items must stay on a single line")
        text = re.sub(r"^(?:[-*•]\s*)", "", text).strip()
        if not text or len(text) > MAX_REPORT_ITEM_CHARS:
            raise SystemExit(
                f"utp report: --{name} items must contain 1-{MAX_REPORT_ITEM_CHARS} characters"
            )
        if TECHNICAL_REPORT_NOISE_RE.search(text) or COMMIT_ID_RE.search(text):
            raise SystemExit(f"utp report: --{name} contains technical workflow noise")
        if PROTECTED_VALUE_RE.search(text):
            raise SystemExit(f"utp report: --{name} contains a protected value")
        key = text.casefold()
        if key not in seen:
            seen.add(key)
            items.append(text)
    if len(items) > MAX_SECTION_ITEMS:
        raise SystemExit(f"utp report: --{name} accepts at most {MAX_SECTION_ITEMS} items")
    return items




MAX_REPLY_BYTES = 1024 * 1024
TRANSPORT_TIMEOUT = 10


class TransportFailure(SystemExit):
    """A control-socket failure. `sent` is whether the request may have reached the app."""

    def __init__(self, message: str, sent: bool):
        super().__init__(message)
        self.sent = sent
READ_ONLY_COMMANDS = {"list", "inspect", "diagnose", "profiles.list", "profiles.catalog", "message.receipt"}


def call(request: dict, timeout: float | None = None) -> dict:
    """One request/reply. `timeout` extends the transport deadline for a
    bounded server-side wait (receipt waits, provider dial catalog calls); the default stays short."""
    transport_timeout = timeout if timeout is not None else TRANSPORT_TIMEOUT
    sent = False
    readonly = request.get("cmd") in READ_ONLY_COMMANDS or (
        request.get("cmd") in {"open", "close", "profile.switch", "profiles.visibility"}
        and (request.get("action") == "list" or not request.get("confirm"))
    ) or (request.get("cmd") == "provider.dials" and request.get("action") == "list")

    def fail(reason: str) -> None:
        outcome = ("; mutation outcome unknown; do not retry automatically; reconcile with read-only queries"
                   if sent and not readonly else
                   "; no request sent" if not sent else "; read-only request failed")
        raise TransportFailure("utp: " + reason + outcome, sent)

    payload = json.dumps(request).encode() + b"\n"
    if len(payload) > 65536:
        fail("request exceeds 65536-byte limit")
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            deadline = time.monotonic() + transport_timeout
            sock.settimeout(transport_timeout)
            try:
                sock.connect(SOCKET_PATH)
            except OSError as exc:
                # Python may reject an overlong AF_UNIX path without an errno;
                # the OS may instead report ENAMETOOLONG.
                if exc.errno == errno.ENAMETOOLONG or str(exc) == "AF_UNIX path too long":
                    fail(f"SocketPathTooLongError: control socket path is too long ({len(os.fsencode(SOCKET_PATH))} bytes)")
                raise
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                fail("transport timeout")
            sock.settimeout(remaining)
            # sendall may partially write before failing; never replay the request.
            sent = True
            sock.sendall(payload)
            data = bytearray()
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    fail("transport timeout")
                sock.settimeout(remaining)
                chunk = sock.recv(min(65536, MAX_REPLY_BYTES + 1 - len(data)))
                if not chunk:
                    fail("truncated reply" if data else "disconnected before reply")
                data.extend(chunk)
                newline = data.find(b"\n")
                if newline >= 0:
                    if newline > MAX_REPLY_BYTES:
                        fail("oversized reply")
                    line = bytes(data[:newline])
                    break
                if len(data) > MAX_REPLY_BYTES:
                    fail("oversized reply")
    except socket.timeout:
        fail("transport timeout")
    except FileNotFoundError:
        fail("control socket not found (is UltraTerm running?)")
    except ConnectionRefusedError:
        fail("control socket connection refused")
    except OSError:
        fail("control socket disconnected or unavailable")
    try:
        response = json.loads(line.decode("utf-8"))
    except (ValueError, UnicodeError, RecursionError):
        fail("malformed JSON reply")
    if not isinstance(response, dict) or type(response.get("ok")) is not bool:
        fail("malformed reply: expected object with boolean ok")
    if response["ok"] and request.get("cmd") == "inspect" and not isinstance(response.get("text"), str):
        fail("malformed inspect reply: expected text string")
    return response


def profile_create_request(args: argparse.Namespace) -> dict:
    name = args.name or args.name_option
    model = args.model or args.model_option
    thinking = args.thinking or args.thinking_option
    missing = [label for label, value in (("name", name), ("model", model), ("thinking", thinking)) if not value]
    if missing:
        raise SystemExit(f"utp profiles create: missing {', '.join(missing)}")
    request = {
        "cmd": "profiles.create",
        "name": name,
        "model": model,
        "thinkingLevel": thinking,
    }
    title_model = args.title_model or args.title_model_option
    if title_model:
        request["titleModel"] = title_model
    routing = getattr(args, "routing", None)
    if routing:
        request["routing"] = routing.strip()
    return request


